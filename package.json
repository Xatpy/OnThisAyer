{
  "name": "tal-dia-como-hoy",
  "version": "1.0.0",
  "description": "Extractor de efemérides con fotos, renderizador HD y web pública para Ayer App",
  "main": "src/server.js",
  "type": "module",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "test": "node --test",
    "fetch": "node src/cli/fetch.js",
    "fetch:all": "node src/cli/fetch.js --all",
    "render": "node src/cli/render.js",
    "curate:batch": "node src/cli/batch.js",
    "clean": "node src/cli/clean.js",
    "video": "node src/cli/video.js",
    "video:render": "node src/cli/video.js",
    "video:batch": "node src/cli/video-batch.js",
    "video:sync": "node src/cli/sync-videos.js",
    "video:preview": "remotion studio src/video/remotion/index.ts"
  },
  "keywords": [
    "on-this-day",
    "efemerides",
    "ayer-app",
    "memories",
    "wikipedia",
    "social-media",
    "github-pages"
  ],
  "author": "Chapiware",
  "license": "MIT",
  "dependencies": {
    "@remotion/bundler": "^4.0.264",
    "@remotion/cli": "^4.0.264",
    "@remotion/renderer": "^4.0.264",
    "playwright": "^1.58.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "remotion": "^4.0.264"
  },
  "devDependencies": {
    "@types/react": "^18.3.18",
    "typescript": "^5.7.3"
  }
}
